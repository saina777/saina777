# MetaTrader 5 terminal/auth configuration
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

# Safety defaults (paper-only v1)
TRADING_MODE=paper
ENABLE_LIVE_TRADING=false
ALLOWED_SYMBOLS=EURUSD,XAUUSD
DEFAULT_TIMEFRAME=M15

# Risk controls
MAX_RISK_PER_TRADE_PCT=0.50
MAX_TOTAL_OPEN_RISK_PCT=2.00
MAX_DAILY_DRAWDOWN_PCT=2.50
MAX_WEEKLY_DRAWDOWN_PCT=5.00
MAX_SPREAD_EURUSD_POINTS=25
MAX_SPREAD_XAUUSD_POINTS=80
